﻿@{
ViewData["Title"] = "Sales Records";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<div class="row g-4">

    <!-- SIMPLE SEARCH -->

    <div class="col-md-6">

        <div class="card shadow-sm h-100 border-0">

            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    Simple Search
                </h5>
            </div>

            <div class="card-body">

                <p class="text-muted">
                    Search sales records by date range.
                </p>

                <form asp-action="SimpleSearch">

                    <div class="mb-3">
                        <label for="minDate" class="form-label">
                            Min Date
                        </label>

                        <input type="date"
                               name="minDate"
                               class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label for="maxDate" class="form-label">
                            Max Date
                        </label>

                        <input type="date"
                               name="maxDate"
                               class="form-control" />
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Search
                    </button>

                </form>

            </div>

        </div>

    </div>

    <!-- GROUPING SEARCH -->

    <div class="col-md-6">

        <div class="card shadow-sm h-100 border-0">

            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">
                    Grouping Search
                </h5>
            </div>

            <div class="card-body">

                <p class="text-muted">
                    Search and group sales by department.
                </p>

                <form asp-action="GroupingSearch">

                    <div class="mb-3">
                        <label for="minDate" class="form-label">
                            Min Date
                        </label>

                        <input type="date"
                               name="minDate"
                               class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label for="maxDate" class="form-label">
                            Max Date
                        </label>

                        <input type="date"
                               name="maxDate"
                               class="form-control" />
                    </div>

                    <button type="submit"
                            class="btn btn-dark w-100">
                        Group Search
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>